{
  "expo": {
    "name": "My PKK Warakas",
    "slug": "mypkk",
    "owner": "sky-fly365",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#e0f7fa"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pkk.warakas.laporan",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#e0f7fa"
      },
      "package": "com.pkk.warakas.laporan",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi ini memerlukan akses ke galeri foto untuk melampirkan dokumentasi kegiatan.",
          "cameraPermission": "Aplikasi ini memerlukan akses ke kamera untuk mengambil foto dokumentasi kegiatan."
        }
      ],
      "./plugins/withSplashScreenFix"
    ],
    "extra": {
      "eas": {
        "projectId": "e45a0574-38c0-4506-9225-947c583045a5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e45a0574-38c0-4506-9225-947c583045a5",
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}

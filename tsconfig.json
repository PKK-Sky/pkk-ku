{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@": [
        "src/index.ts"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@types": [
        "src/types/index.ts"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@components": [
        "src/components/index.ts"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@screens": [
        "src/screens/index.ts"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@services": [
        "src/services/index.ts"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@hooks": [
        "src/hooks/index.ts"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@utils": [
        "src/utils/index.ts"
      ],
      "@constants/*": [
        "src/constants/*"
      ],
      "@constants": [
        "src/constants/index.ts"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@context/*": [
        "src/context/*"
      ],
      "@navigation/*": [
        "src/navigation/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}

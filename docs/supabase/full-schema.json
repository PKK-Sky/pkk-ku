create or replace function public.is_admin()
returns boolean language sql stable security definer set search_path to 'public' as $$
  select exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin');
$$;

create or replace function public.is_active_member()
returns boolean language sql stable security definer set search_path to 'public' as $$
  select exists (select 1 from public.members m where m.user_id = auth.uid() and m.registration_status = 'active');
$$;

create or replace function public.is_post_active(p_post_id uuid)
returns boolean language sql stable security definer set search_path to 'public' as $$
  select exists (select 1 from public.posts p where p.id = p_post_id and p.expires_at > now());
$$;

create or replace function public.can_manage_announcements()
returns boolean language sql stable security definer set search_path to 'public' as $$
  select exists (select 1 from public.profiles pr where pr.id = auth.uid() and pr.role = 'admin')
  or exists (
    select 1 from public.members m join public.positions p on p.id = m.position_id
    where m.user_id = auth.uid() and m.registration_status = 'active'
      and p.code in ('KETUA','WAKIL_KETUA')
  );
$$;

create or replace function public.can_create_report()
returns boolean language sql stable security definer set search_path to 'public' as $$
  select exists (
    select 1 from public.members m join public.positions p on p.id = m.position_id
    where m.user_id = auth.uid() and m.registration_status = 'active'
      and p.name in ('Bendahara','Sekretaris','Pokja I','Pokja II','Pokja III','Pokja IV')
  );
$$;

create or replace function public.get_current_chairperson_name()
returns text language sql stable security definer set search_path to 'public' as $$
  select m.full_name from public.members m join public.positions p on p.id = m.position_id
  where m.registration_status = 'active' and p.name = 'Ketua'
  order by m.created_at asc limit 1;
$$;

create or replace function public.get_current_member_name()
returns text language sql stable security definer set search_path to 'public' as $$
  select m.full_name from public.members m
  where m.user_id = auth.uid() and m.registration_status = 'active' limit 1;
$$;

create or replace function public.get_current_member_position()
returns text language sql stable security definer set search_path to 'public' as $$
  select p.name from public.members m join public.positions p on p.id = m.position_id
  where m.user_id = auth.uid() and m.registration_status = 'active' limit 1;
$$;

create or replace function public.chat_is_non_admin(p_user_id uuid)
returns boolean language sql stable security definer set search_path to 'public','auth','extensions' as $$
  select exists (select 1 from public.profiles p where p.id = p_user_id and p.role <> 'admin');
$$;

create or replace function public.queue_user_push(
  p_user_id uuid, p_kind text, p_event_key text, p_title text, p_body text, p_data jsonb default '{}'::jsonb
) returns void language plpgsql security definer set search_path to 'public','auth','extensions' as $$
begin
  insert into public.push_queue (device_id, user_id, kind, event_key, title, body, data)
  select d.id, d.user_id, p_kind, p_event_key, left(p_title,160), left(p_body,500), coalesce(p_data,'{}'::jsonb)
  from public.push_devices d
  join public.notification_preferences pref on pref.user_id = d.user_id
  where d.user_id = p_user_id
    and d.enabled = true
    and case p_kind
      when 'chat_message' then pref.chat_messages
      when 'report_received' then pref.report_received
      when 'announcement' then pref.announcements
      when 'social_activity' then pref.social_activity
      else true
    end
  on conflict (device_id, event_key) do nothing;
end;
$$;

create or replace function public.check_max_active_announcements()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
declare active_count integer;
begin
  if new.is_active = true then
    select count(*) into active_count from public.announcements
    where is_active = true and id <> new.id
      and (start_at is null or start_at <= now())
      and (end_at is null or end_at >= now());
    if active_count >= 3 then
      raise exception 'Maksimal 3 pengumuman aktif yang dapat ditampilkan';
    end if;
  end if;
  return new;
end;
$$;

create or replace function public.update_announcements_updated_at()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
begin new.updated_at = now(); return new; end;
$$;

create or replace function public.notify_new_announcement()
returns trigger language plpgsql security definer set search_path to 'public' as $$
declare recipient record; v_title text; v_preview text;
begin
  if new.is_active is distinct from true then return new; end if;
  v_title := coalesce(new.title, 'Pengumuman baru');
  v_preview := left(new.message, 160);
  for recipient in
    select m.user_id from public.members m
    where m.registration_status = 'active' and m.user_id is not null
      and m.user_id is distinct from new.created_by
  loop
    insert into public.notification_inbox (user_id, kind, title, body, data)
    values (recipient.user_id, 'announcement', v_title, v_preview, jsonb_build_object('announcement_id', new.id));
    perform public.queue_user_push(recipient.user_id, 'announcement', 'announcement:' || new.id::text, v_title, v_preview, jsonb_build_object('announcement_id', new.id));
  end loop;
  return new;
end;
$$;

create or replace function public.validate_post_expiration()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
begin
  if new.expires_at > new.created_at + interval '48 hours' then
    raise exception 'Post maksimal aktif 48 jam';
  end if;
  if new.expires_at <= new.created_at then
    raise exception 'expires_at harus lebih besar dari created_at';
  end if;
  return new;
end;
$$;

create or replace function public.update_posts_updated_at()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
begin new.updated_at = now(); return new; end;
$$;

create or replace function public.validate_post_media()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
declare image_count integer; video_count integer;
begin
  if not exists (select 1 from public.posts where id = new.post_id and expires_at > now()) then
    raise exception 'Post sudah tidak aktif';
  end if;
  select count(*) filter (where media_type = 'image'), count(*) filter (where media_type = 'video')
  into image_count, video_count
  from public.post_media where post_id = new.post_id and id <> new.id;
  if new.media_type = 'video' then
    if video_count >= 1 then raise exception 'Satu post maksimal 1 video'; end if;
    if image_count > 0 then raise exception 'Video tidak boleh digabung dengan foto'; end if;
    if new.duration_seconds is null then raise exception 'Durasi video wajib diisi'; end if;
    if new.duration_seconds > 60 then raise exception 'Durasi video maksimal 60 detik'; end if;
  end if;
  if new.media_type = 'image' then
    if image_count >= 5 then raise exception 'Satu post maksimal 5 foto'; end if;
    if video_count > 0 then raise exception 'Foto tidak boleh digabung dengan video'; end if;
    new.duration_seconds := null;
  end if;
  return new;
end;
$$;

create or replace function public.notify_post_like()
returns trigger language plpgsql security definer set search_path to 'public' as $$
declare v_post_owner uuid; v_liker_name text;
begin
  select p.user_id into v_post_owner from public.posts p where p.id = new.post_id;
  if v_post_owner is null or v_post_owner = new.user_id then return new; end if;
  select m.full_name into v_liker_name from public.members m where m.user_id = new.user_id;
  insert into public.notification_inbox (user_id, kind, title, body, data)
  values (v_post_owner, 'social_activity', coalesce(v_liker_name,'Seseorang') || ' menyukai postingan Anda', null,
    jsonb_build_object('post_id', new.post_id, 'liker_id', new.user_id, 'type', 'like'));
  perform public.queue_user_push(v_post_owner, 'social_activity', 'post_like:' || new.post_id::text || ':' || new.user_id::text,
    coalesce(v_liker_name,'Seseorang') || ' menyukai postingan Anda', '',
    jsonb_build_object('post_id', new.post_id, 'liker_id', new.user_id, 'type', 'like'));
  return new;
end;
$$;

create or replace function public.validate_post_comment_parent()
returns trigger language plpgsql security definer set search_path to 'public' as $$
begin
  if new.parent_comment_id is not null then
    if not exists (select 1 from public.post_comments pc where pc.id = new.parent_comment_id and pc.post_id = new.post_id) then
      raise exception 'Komentar induk tidak ditemukan atau bukan milik post yang sama.' using errcode = '22023';
    end if;
  end if;
  return new;
end;
$$;

create or replace function public.update_post_comments_updated_at()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
begin new.updated_at = now(); return new; end;
$$;

create or replace function public.notify_post_comment()
returns trigger language plpgsql security definer set search_path to 'public' as $$
declare v_post_owner uuid; v_parent_author uuid; v_commenter_name text; v_preview text;
begin
  select p.user_id into v_post_owner from public.posts p where p.id = new.post_id;
  select m.full_name into v_commenter_name from public.members m where m.user_id = new.user_id;
  v_preview := left(new.content, 160);
  if v_post_owner is not null and v_post_owner <> new.user_id then
    insert into public.notification_inbox (user_id, kind, title, body, data)
    values (v_post_owner, 'social_activity', coalesce(v_commenter_name,'Seseorang') || ' mengomentari postingan Anda', v_preview,
      jsonb_build_object('post_id', new.post_id, 'comment_id', new.id, 'commenter_id', new.user_id, 'type', 'comment'));
    perform public.queue_user_push(v_post_owner, 'social_activity', 'post_comment:' || new.id::text || ':post_owner',
      coalesce(v_commenter_name,'Seseorang') || ' mengomentari postingan Anda', v_preview,
      jsonb_build_object('post_id', new.post_id, 'comment_id', new.id, 'commenter_id', new.user_id, 'type', 'comment'));
  end if;
  if new.parent_comment_id is not null then
    select pc.user_id into v_parent_author from public.post_comments pc where pc.id = new.parent_comment_id;
    if v_parent_author is not null and v_parent_author <> new.user_id and v_parent_author is distinct from v_post_owner then
      insert into public.notification_inbox (user_id, kind, title, body, data)
      values (v_parent_author, 'social_activity', coalesce(v_commenter_name,'Seseorang') || ' membalas komentar Anda', v_preview,
        jsonb_build_object('post_id', new.post_id, 'comment_id', new.id, 'parent_comment_id', new.parent_comment_id, 'commenter_id', new.user_id, 'type', 'reply'));
      perform public.queue_user_push(v_parent_author, 'social_activity', 'post_comment:' || new.id::text || ':parent_author',
        coalesce(v_commenter_name,'Seseorang') || ' membalas komentar Anda', v_preview,
        jsonb_build_object('post_id', new.post_id, 'comment_id', new.id, 'parent_comment_id', new.parent_comment_id, 'commenter_id', new.user_id, 'type', 'reply'));
    end if;
  end if;
  return new;
end;
$$;

create or replace function public.populate_report_identity()
returns trigger language plpgsql security definer set search_path to 'public' as $$
begin
  new.created_by := auth.uid();
  new.creator_name := public.get_current_member_name();
  new.creator_position := public.get_current_member_position();
  new.chairperson_name := public.get_current_chairperson_name();
  if new.creator_name is null then raise exception 'Data pembuat laporan tidak ditemukan.'; end if;
  if new.creator_position is null then raise exception 'Jabatan pembuat laporan tidak ditemukan.'; end if;
  if new.chairperson_name is null then raise exception 'Ketua TP PKK belum ditemukan.'; end if;
  return new;
end;
$$;

create or replace function public.validate_report_creator()
returns trigger language plpgsql security definer set search_path to 'public' as $$
begin
  if not public.can_create_report() then
    raise exception 'User tidak memiliki jabatan yang diperbolehkan membuat laporan.';
  end if;
  return new;
end;
$$;

create or replace function public.update_report_updated_at()
returns trigger language plpgsql set search_path to 'public','auth','extensions' as $$
begin new.updated_at = now(); return new; end;
$$;

create or replace function public.create_report_recipients()
returns trigger language plpgsql security definer set search_path to 'public' as $$
begin
  insert into public.report_recipients (report_id, recipient_user_id, recipient_type)
  select new.id, p.id, 'admin' from public.profiles p where p.role = 'admin'
  on conflict (report_id, recipient_user_id) do nothing;

  insert into public.report_recipients (report_id, recipient_user_id, recipient_type)
  select new.id, m.user_id, 'ketua' from public.members m join public.positions pos on pos.id = m.position_id
  where m.registration_status = 'active' and pos.name = 'Ketua' and m.user_id is not null
  on conflict (report_id, recipient_user_id) do nothing;

  insert into public.report_recipients (report_id, recipient_user_id, recipient_type)
  select new.id, m.user_id, 'wakil_ketua' from public.members m join public.positions pos on pos.id = m.position_id
  where m.registration_status = 'active' and pos.name = 'Wakil Ketua' and m.user_id is not null
  on conflict (report_id, recipient_user_id) do nothing;

  return new;
end;
$$;

create or replace function public.validate_report_media()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
declare media_count integer;
begin
  select count(*) into media_count from public.report_media
  where report_id = new.report_id and id <> coalesce(new.id, gen_random_uuid());
  if media_count >= 2 then
    raise exception 'Maksimal 2 foto dokumentasi untuk satu laporan.';
  end if;
  return new;
end;
$$;

create or replace function public.notify_report_recipient()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
declare report_row record;
begin
  select r.activity_name, r.creator_name into report_row from public.reports r where r.id = new.report_id;
  insert into public.notification_inbox (user_id, kind, title, body, data)
  values (new.recipient_user_id, 'report_received', 'Laporan kegiatan baru',
    left(coalesce(report_row.activity_name,'Laporan kegiatan') || ' — ' || coalesce(report_row.creator_name,'Pembuat laporan'), 500),
    jsonb_build_object('report_id', new.report_id, 'recipient_type', new.recipient_type));
  perform public.queue_user_push(new.recipient_user_id, 'report_received', 'report_received:' || new.id::text,
    'Laporan kegiatan baru',
    left(coalesce(report_row.activity_name,'Laporan kegiatan') || ' — ' || coalesce(report_row.creator_name,'Pembuat laporan'), 500),
    jsonb_build_object('report_id', new.report_id, 'recipient_type', new.recipient_type));
  return new;
end;
$$;

create or replace function public.check_position_capacity()
returns trigger language plpgsql security definer set search_path to 'public' as $$
declare position_code text; max_members integer; current_members integer;
begin
  select code into position_code from public.positions where id = new.position_id;
  max_members := case position_code
    when 'KETUA' then 1 when 'WAKIL_KETUA' then 1 when 'SEKRETARIS' then 1 when 'BENDAHARA' then 1
    when 'POKJA_I' then 2 when 'POKJA_II' then 2 when 'POKJA_III' then 2 when 'POKJA_IV' then 2
    else null end;
  if max_members is null then return new; end if;
  select count(*) into current_members from public.members
  where position_id = new.position_id and registration_status <> 'blocked' and id <> new.id;
  if current_members >= max_members then
    raise exception 'Jabatan % sudah mencapai kapasitas maksimal % anggota', position_code, max_members;
  end if;
  return new;
end;
$$;

create or replace function public.check_member_by_phone(p_phone text)
returns jsonb language plpgsql security definer set search_path to 'public' as $$
declare v_member record; v_attempts integer;
begin
  p_phone := trim(p_phone);
  if p_phone is null or length(p_phone) < 6 then
    raise exception 'Nomor HP tidak valid.' using errcode = '22023';
  end if;
  select count(*) into v_attempts from public.phone_check_attempts
  where phone = p_phone and attempted_at > now() - interval '15 minutes';
  if v_attempts >= 5 then
    raise exception 'Terlalu banyak percobaan. Silakan coba lagi dalam beberapa menit.' using errcode = '42901';
  end if;
  insert into public.phone_check_attempts (phone) values (p_phone);
  select m.id, m.full_name, m.registration_status, m.user_id, pos.name as position_name
  into v_member from public.members m join public.positions pos on pos.id = m.position_id where m.phone = p_phone;
  if v_member is null then
    return jsonb_build_object('found', false, 'message', 'Nomor HP tidak terdaftar di sistem. Silakan hubungi admin.');
  end if;
  if v_member.user_id is not null then
    return jsonb_build_object('found', true, 'already_registered', true, 'message', 'Nomor ini sudah terdaftar dengan akun. Silakan login.');
  end if;
  if v_member.registration_status = 'blocked' then
    return jsonb_build_object('found', true, 'blocked', true, 'message', 'Akun ini diblokir. Silakan hubungi admin.');
  end if;
  return jsonb_build_object('found', true, 'already_registered', false, 'blocked', false,
    'full_name', v_member.full_name, 'position_name', v_member.position_name);
end;
$$;

create or replace function public.complete_member_registration(p_phone text, p_address text default null, p_avatar_url text default null)
returns jsonb language plpgsql security definer set search_path to 'public' as $$
declare v_uid uuid := auth.uid(); v_member record;
begin
  if v_uid is null then
    raise exception 'Sesi login tidak ditemukan. Silakan verifikasi OTP terlebih dahulu.' using errcode = '42501';
  end if;
  p_phone := trim(p_phone);
  select * into v_member from public.members where phone = p_phone for update;
  if v_member is null then raise exception 'Data anggota dengan nomor tersebut tidak ditemukan.'; end if;
  if v_member.user_id is not null and v_member.user_id <> v_uid then
    raise exception 'Nomor ini sudah terhubung dengan akun lain.';
  end if;
  if v_member.registration_status = 'blocked' then
    raise exception 'Akun ini diblokir. Silakan hubungi admin.';
  end if;
  update public.members set user_id = v_uid, address = coalesce(p_address, address),
    avatar_url = coalesce(p_avatar_url, avatar_url), registration_status = 'active', updated_at = now()
  where id = v_member.id;
  insert into public.profiles (id, name) values (v_uid, v_member.full_name) on conflict (id) do nothing;
  return jsonb_build_object('success', true, 'member_id', v_member.id);
end;
$$;

create or replace function public.ensure_notification_preferences()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
begin
  insert into public.notification_preferences (user_id) values (new.id) on conflict (user_id) do nothing;
  return new;
end;
$$;

create or replace function public.notifications_touch_updated_at()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
begin new.updated_at = now(); return new; end;
$$;

create or replace function public.create_direct_chat(p_other_user_id uuid)
returns uuid language plpgsql security definer set search_path to 'public','auth','extensions' as $$
declare v_me uuid := auth.uid(); v_key text; v_conversation_id uuid;
begin
  if v_me is null then raise exception 'Authentication required.' using errcode = '42501'; end if;
  if p_other_user_id is null or p_other_user_id = v_me then
    raise exception 'A chat requires two different users.' using errcode = '22023';
  end if;
  if not public.chat_is_non_admin(v_me) or not public.chat_is_non_admin(p_other_user_id) then
    raise exception 'Admin accounts cannot use direct chat.' using errcode = '42501';
  end if;
  v_key := least(v_me::text, p_other_user_id::text) || ':' || greatest(v_me::text, p_other_user_id::text);
  insert into public.chat_conversations (direct_key, created_by) values (v_key, v_me)
  on conflict (direct_key) do nothing returning id into v_conversation_id;
  if v_conversation_id is null then
    select id into v_conversation_id from public.chat_conversations where direct_key = v_key;
  end if;
  insert into public.chat_members (conversation_id, user_id) values (v_conversation_id, v_me), (v_conversation_id, p_other_user_id)
  on conflict do nothing;
  return v_conversation_id;
end;
$$;

create or replace function public.chat_validate_message()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
begin
  if new.sender_id <> auth.uid() then
    raise exception 'Sender must match the authenticated user.' using errcode = '42501';
  end if;
  if not public.chat_is_non_admin(new.sender_id) then
    raise exception 'Admin accounts cannot send chat messages.' using errcode = '42501';
  end if;
  if not exists (select 1 from public.chat_members cm where cm.conversation_id = new.conversation_id and cm.user_id = new.sender_id) then
    raise exception 'You are not a member of this conversation.' using errcode = '42501';
  end if;
  return new;
end;
$$;

create or replace function public.chat_refresh_conversation_preview()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
begin
  update public.chat_conversations
  set last_message_at = new.created_at, last_message_sender_id = new.sender_id,
      last_message_preview = case when new.deleted_at is null then left(new.body, 160) else '[Pesan dihapus]' end
  where id = new.conversation_id;
  return new;
end;
$$;

create or replace function public.chat_messages_broadcast_insert()
returns trigger language plpgsql security definer as $$
declare _topic text;
begin
  _topic := 'chat:' || new.conversation_id::text || ':messages';
  perform realtime.send(_topic, 'message_created', jsonb_build_object(
    'id', new.id, 'conversation_id', new.conversation_id, 'sender_id', new.sender_id,
    'body', new.body, 'client_message_id', new.client_message_id, 'reply_to_id', new.reply_to_id,
    'created_at', new.created_at
  ), true);
  return new;
end;
$$;

create or replace function public.notify_chat_message()
returns trigger language plpgsql security definer set search_path to 'public','auth','extensions' as $$
declare recipient record; preview text;
begin
  preview := case when new.deleted_at is null then left(new.body, 160) else '[Pesan baru]' end;
  for recipient in select cm.user_id from public.chat_members cm
    where cm.conversation_id = new.conversation_id and cm.user_id <> new.sender_id
  loop
    insert into public.notification_inbox (user_id, kind, title, body, data)
    values (recipient.user_id, 'chat_message', 'Pesan baru', preview,
      jsonb_build_object('conversation_id', new.conversation_id, 'message_id', new.id, 'sender_id', new.sender_id));
    perform public.queue_user_push(recipient.user_id, 'chat_message', 'chat_message:' || new.id::text, 'Pesan baru', preview,
      jsonb_build_object('conversation_id', new.conversation_id, 'message_id', new.id, 'sender_id', new.sender_id));
  end loop;
  return new;
end;
$$;


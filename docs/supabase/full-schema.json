create trigger posts_updated_at before update on public.posts for each row execute function update_posts_updated_at();

create trigger post_media_validate before insert or update on public.post_media for each row execute function validate_post_media();

create trigger post_likes_notify_trigger after insert on public.post_likes for each row execute function notify_post_like();

create trigger post_comments_validate_parent before insert on public.post_comments for each row execute function validate_post_comment_parent();
create trigger post_comments_updated_at before update on public.post_comments for each row execute function update_post_comments_updated_at();
create trigger post_comments_notify_trigger after insert on public.post_comments for each row execute function notify_post_comment();

create trigger populate_report_identity_trigger before insert on public.reports for each row execute function populate_report_identity();
create trigger validate_report_creator_trigger before insert on public.reports for each row execute function validate_report_creator();
create trigger update_reports_updated_at_trigger before update on public.reports for each row execute function update_report_updated_at();
create trigger create_report_recipients_trigger after insert on public.reports for each row execute function create_report_recipients();


-- =====================================================================
-- CRON JOBS (pg_cron)
-- =====================================================================
select cron.schedule(
  'cleanup-expired-posts',
  '0 * * * *',
  $$
    select net.http_post(
      url := current_setting('app.settings.supabase_url') || '/functions/v1/cleanup-expired-posts',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'Authorization', 'Bearer ' || current_setting('app.settings.service_role_key')
      ),
      body := '{}'::jsonb
    );
  $$
);

select cron.schedule(
  'cleanup-phone-check-attempts',
  '0 3 * * *',
  $$ delete from public.phone_check_attempts where attempted_at < now() - interval '1 day' $$
);

select cron.schedule(
  'send-push-notifications-every-minute',
  '* * * * *',
  $$
    select net.http_post(
      url := 'https://vmbqsogwiaqwqmjpobge.supabase.co/functions/v1/send-push-notifications',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'Authorization', 'Bearer ' || (select decrypted_secret from vault.decrypted_secrets where name = 'push_cron_secret')
      ),
      body := '{}'::jsonb
    ) as request_id;
  $$
);

